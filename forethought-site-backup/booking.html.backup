<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Book an Appointment | Forethought Care &amp; Support</title>
    <meta
      name="description"
      content="Book an appointment using our simple online booking system."
    />

    <!-- ✅ Stylesheets (from /css folder) -->
    <link rel="stylesheet" href="css/styles.css" />
    <link rel="stylesheet" href="css/booking.css" />

    <!-- ✅ Scripts (from root) -->
    <script src="script.js" defer></script>
    <script src="booking.js" defer></script>
  </head>

  <body
    class="has-sidebar"
    data-business-email="forethoughtcareandsupport@gmail.com"
  >
    <!-- HEADER -->
    <!--#include file="includes/header-root.html" -->

    <header class="site-header">
      <div class="site-header__inner">
        <div class="container header-inner">
          <a class="brand" href="index.html">
            <img
              class="brand-mark"
              src="assets/prometheus-mark.png"
              alt="Forethought Care & Support logo"
            />
          </a>

          <button
            class="menu-toggle"
            type="button"
            aria-expanded="false"
            data-menu-toggle
          >
            Menu
          </button>
        </div>

        <div class="container nav-row">
          <nav class="site-nav" aria-label="Primary navigation" data-site-nav>
            <a href="index.html">Home</a>
            <a href="services.html">Services</a>
            <a href="team.html">Team</a>
            <a href="pages/about.html">About</a>
            <a href="pages/testimonials.html">Testimonials</a>
            <a href="pages/blog.html">Blog</a>
            <a href="pages/contact.html">Contact</a>
            <a href="pages/eLearning.html">eLearning</a>
            <a href="pages/crm-portal.html">CRM Portal</a>
            <a href="/admin.html" style="display: none">Admin</a>
          </nav>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="container">
          <h2>Request a Booking</h2>
          <p>
            Use this form to request a time to discuss your needs or services.
            We’ll confirm suitability and next steps before any session
            proceeds.
          </p>
          <p class="small-note">
            Some services are offered for individuals seeking structured,
            non‑residential support. Submitting a booking request does not
            guarantee service availability, and we will always confirm alignment
            with your goals before proceeding.
          </p>
        </div>
      </section>

      <section class="contact booking">
        <div class="container contact-grid booking-grid">
          <!-- Booking Form -->
          <form
            id="bookingForm"
            class="form"
            name="booking"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="success.html"
            novalidate
          >
            <!-- Required for Netlify -->
            <input type="hidden" name="form-name" value="booking" />

            <!-- Submission timestamp -->
            <input
              type="hidden"
              name="submission_timestamp"
              value=""
              data-submission-timestamp
            />

            <!-- Honeypot (spam protection) -->
            <p class="visually-hidden">
              <label>
                Don’t fill this out if you’re human:
                <input name="bot-field" />
              </label>
            </p>
            <!-- Provider -->
            <label for="provider">Preferred provider (if you have one)</label>
            <select id="provider" name="provider" required>
              <option value="" selected disabled>
                -- Choose a provider --
              </option>
              <option value="any">Any available</option>
              <option value="jaqueline">Jaqueline Robinson</option>
              <option value="patrick">Patrick Daigneault</option>
              <option value="nikki">Nikki Sutherland</option>
              <option value="nadia">Nadia Daigneault</option>
              <option value="leah">Leah Daigneault</option>
              <option value="kayla">Kayla Gagne</option>
            </select>

            <label>
              Service you’re enquiring about
              <p class="small-note">
                Selected dates and times are a request only and may need to be
                adjusted based on availability and service suitability.
              </p>
              <select id="bService" name="service" required>
                <option value="">Select a service</option>
                <option value="Individual Support &amp; Recovery Coaching">
                  Individual Support &amp; Recovery Coaching
                </option>
                <option value="Business Support &amp; Administration">
                  Business Support &amp; Administration
                </option>
                <option value="Workplace Training &amp; Assessment">
                  Workplace Training &amp; Assessment
                </option>
                <option value="Research Ethics &amp; Governance Support">
                  Research Ethics &amp; Governance Support
                </option>
                <option value="Other">Other</option>
              </select>
              <span class="error" id="bServiceError"></span>
            </label>

            <label>
              Date
              <input
                type="text"
                id="bDate"
                name="date"
                required
                readonly
                placeholder="YYYY-MM-DD"
              />
              <span class="error" id="bDateError"></span>
            </label>

            <!-- Calendar UI -->
            <div class="calendar" aria-label="Calendar">
              <div class="calendar-header">
                <button
                  type="button"
                  class="btn btn-secondary calendar-nav"
                  id="calPrev"
                  aria-label="Previous month"
                ></button>
                <div class="calendar-title" id="calTitle">Month YYYY</div>
                <button
                  type="button"
                  class="btn btn-secondary calendar-nav"
                  id="calNext"
                  aria-label="Next month"
                ></button>
              </div>

              <div class="calendar-weekdays" aria-hidden="true">
                <div>Sun</div>
                <div>Mon</div>
                <div>Tue</div>
                <div>Wed</div>
                <div>Thu</div>
                <div>Fri</div>
                <div>Sat</div>
              </div>

              <div class="calendar-grid" id="calGrid"></div>

              <div class="calendar-legend">
                <span class="dot booked">Booked day</span>
                <span class="dot full">Fully booked</span>
                <span class="dot selected">Selected</span>
              </div>
            </div>

            <!-- ✅ START TIME ONLY -->
            <label>
              Start time
              <input
                type="time"
                id="bTime"
                name="start_time"
                required
                step="60"
              />
              <span class="error" id="bTimeError"></span>
            </label>

            <p class="subtext">
              Session length will be discussed and agreed before the
              appointment.
            </p>

            <label>
              Name
              <input type="text" id="bName" name="name" required />
              <span class="error" id="bNameError"></span>
            </label>

            <label>
              Email
              <input type="email" id="bEmail" name="email" required />
              <span class="error" id="bEmailError"></span>
            </label>

            <label>
              Phone (optional)
              <input type="tel" id="bPhone" name="phone" />
              <span class="error" id="bPhoneError"></span>
            </label>

            <label>
              Notes or information you’d like us to be aware of (optional)
              <textarea id="bNotes" name="notes" rows="3"></textarea>
            </label>
            <p class="small-note">
              Submitting a booking request does not create an obligation to
              proceed with services.
            </p>
            <button class="btn" type="submit">Send booking request</button>
            <button class="btn btn-secondary" type="button" id="clearAll">
              Clear All
            </button>
          </form>

          <!-- Right column -->
          <div class="contact-info card">
            <h3>Bookings</h3>
            <div id="bookingList" class="booking-list"></div>
            <p class="subtext"></p>
          </div>
        </div>
      </section>
    </main>

    <!-- Confirmation Modal -->
    <div class="modal-overlay" id="confirmOverlay" hidden></div>

    <div
      class="modal"
      id="confirmModal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="confirmTitle"
      hidden
    >
      <h3 id="confirmTitle">Confirm your booking request</h3>
      <div class="modal-summary" id="confirmSummary"></div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" id="confirmCancel">
          Cancel
        </button>
        <button type="button" class="btn" id="confirmSubmit">
          Send request
        </button>
      </div>
    </div>

    <!-- FOOTER -->
    <!--#include file="includes/footer-root.html" -->

    <footer class="footer">
      <div class="container footer-bottom">
        <p>© <span id="year"></span> Forethought. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
