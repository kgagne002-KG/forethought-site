<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Outcomes | Forethought Care &amp; Support</title>
    <link rel="stylesheet" href="../css/styles.css" />
    <script src="../js/main.js" defer></script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- HEADER -->
    <!--#include file="../includes/header-pages.html" -->

    <header class="site-header">
      <div class="site-header__inner">
        <!-- BRAND ROW -->
        <div class="container header-inner">
          <a class="brand" href="../index.html">
            <img
              class="brand-mark"
              src="../assets/prometheus-mark.png"
              alt="Forethought Care &amp; Support logo"
            />
          </a>

          <button
            class="menu-toggle"
            type="button"
            aria-expanded="false"
            data-menu-toggle
          >
            Menu
          </button>
        </div>

        <!-- NAV ROW -->
        <div class="container nav-row">
          <nav class="site-nav" aria-label="Primary navigation" data-site-nav>
            <a href="../index.html">Home</a>
            <a href="../services.html">Services</a>
            <a href="../team.html">Team</a>

            <a href="about.html">About</a>
            <a href="testimonials.html">Testimonials</a>

            <a href="contact.html">Contact</a>

            <a href="eLearning.html">eLearning</a>
            <a href="crm-portal.html">CRM Portal</a>
          </nav>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <h1>Outcomes &amp; Testimonials</h1>
            <p class="hero-subhead">
              Anonymised vignettes showing measurable progress aligned to
              individual goals (no identifying details).
            </p>
          </div>

          <aside class="hero-aside">
            <div class="texture-card" aria-hidden="true"></div>
            <p class="small-note" style="margin-top: 0.75rem">
              Outcomes vary by person and circumstances. We focus on progress
              markers, documentation and participant choice.
            </p>
          </aside>
        </div>
      </section>

      <section class="section section--alt">
        <div class="container">
          <h2>Vignettes</h2>

          <div
            class="carousel"
            aria-label="Outcome vignettes carousel"
            data-basic-carousel
          >
            <article class="carousel-item is-active" data-carousel-item>
              <h3>Recovery Coaching — Community Participation</h3>
              <p>
                <strong>Situation:</strong> Participant sought support to
                increase community engagement after plan changes reduced
                supports.
              </p>
              <p>
                <strong>Approach:</strong> Strengths mapping, coaching block,
                warm referrals to local groups.
              </p>
              <p>
                <strong>Outcome:</strong> Increased confidence and regular
                participation aligned to personal goals within 12 weeks.
              </p>
            </article>

            <article class="carousel-item" data-carousel-item>
              <h3>Behaviour Support — Practical Implementation</h3>
              <p>
                <strong>Situation:</strong> Behaviour of concern impacted
                participation and consistency.
              </p>
              <p>
                <strong>Approach:</strong> Functional assessment, co‑designed
                PBS plan, implementation coaching and staff training.
              </p>
              <p>
                <strong>Outcome:</strong> Clearer approaches and reduced need
                for restrictive responses over time.
              </p>
            </article>

            <article class="carousel-item" data-carousel-item>
              <h3>Plan Review Support — Evidence &amp; Advocacy</h3>
              <p>
                <strong>Situation:</strong> Plan review risk with limited
                evidence and under‑funding concerns.
              </p>
              <p>
                <strong>Approach:</strong> Evidence summary, outcome markers,
                advocacy brief and preparation.
              </p>
              <p>
                <strong>Outcome:</strong> Stronger plan alignment to goals and
                clearer pathways to required supports.
              </p>
            </article>

            <div class="carousel-controls">
              <button
                type="button"
                data-carousel-prev
                aria-label="Previous vignette"
              >
                Previous
              </button>
              <button
                type="button"
                data-carousel-next
                aria-label="Next vignette"
              >
                Next
              </button>
            </div>
          </div>

          <div class="cta-row">
            <a class="btn btn-primary" href="contact.html"
              >Book a consultation</a
            >
            <a class="btn btn-secondary" href="../services.html"
              >Explore services</a
            >
          </div>
        </div>
        <section class="section">
          <div class="container">
            <h2>Leave a review</h2>
            <p class="small-note">
              Share your experience. Reviews are moderated before publishing.
            </p>

            <form class="review-form" data-review-form>
              <div class="review-form__row">
                <label class="review-form__label" for="review-name"
                  >Name (optional)</label
                >
                <input
                  class="review-form__input"
                  id="review-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                />
              </div>

              <div class="review-form__row">
                <p class="review-form__label" id="review-rating-label">
                  Your rating
                </p>

                <fieldset
                  class="rating testimonial-rating"
                  aria-labelledby="review-rating-label"
                >
                  <legend class="visually-hidden">Star rating</legend>

                  <input
                    class="rating__input"
                    type="radio"
                    name="rating"
                    id="rr5"
                    value="5"
                  />
                  <label
                    class="rating__star"
                    for="rr5"
                    aria-label="5 stars"
                    title="5 stars"
                  >
                    <svg
                      class="rating__svg"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M12 2.2l2.93 6.06 6.69.98-4.84 4.72 1.14 6.66L12 17.98 6.08 20.62l1.14-6.66L2.38 9.24l6.69-.98L12 2.2z"
                      ></path>
                    </svg>
                  </label>

                  <input
                    class="rating__input"
                    type="radio"
                    name="rating"
                    id="rr4"
                    value="4"
                  />
                  <label
                    class="rating__star"
                    for="rr4"
                    aria-label="4 stars"
                    title="4 stars"
                  >
                    <svg
                      class="rating__svg"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M12 2.2l2.93 6.06 6.69.98-4.84 4.72 1.14 6.66L12 17.98 6.08 20.62l1.14-6.66L2.38 9.24l6.69-.98L12 2.2z"
                      ></path>
                    </svg>
                  </label>

                  <input
                    class="rating__input"
                    type="radio"
                    name="rating"
                    id="rr3"
                    value="3"
                  />
                  <label
                    class="rating__star"
                    for="rr3"
                    aria-label="3 stars"
                    title="3 stars"
                  >
                    <svg
                      class="rating__svg"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M12 2.2l2.93 6.06 6.69.98-4.84 4.72 1.14 6.66L12 17.98 6.08 20.62l1.14-6.66L2.38 9.24l6.69-.98L12 2.2z"
                      ></path>
                    </svg>
                  </label>

                  <input
                    class="rating__input"
                    type="radio"
                    name="rating"
                    id="rr2"
                    value="2"
                  />
                  <label
                    class="rating__star"
                    for="rr2"
                    aria-label="2 stars"
                    title="2 stars"
                  >
                    <svg
                      class="rating__svg"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M12 2.2l2.93 6.06 6.69.98-4.84 4.72 1.14 6.66L12 17.98 6.08 20.62l1.14-6.66L2.38 9.24l6.69-.98L12 2.2z"
                      ></path>
                    </svg>
                  </label>

                  <input
                    class="rating__input"
                    type="radio"
                    name="rating"
                    id="rr1"
                    value="1"
                  />
                  <label
                    class="rating__star"
                    for="rr1"
                    aria-label="1 star"
                    title="1 star"
                  >
                    <svg
                      class="rating__svg"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M12 2.2l2.93 6.06 6.69.98-4.84 4.72 1.14 6.66L12 17.98 6.08 20.62l1.14-6.66L2.38 9.24l6.69-.98L12 2.2z"
                      ></path>
                    </svg>
                  </label>

                  <output class="rating__value" aria-live="polite">0</output>
                </fieldset>
              </div>

              <div class="review-form__row">
                <label class="review-form__label" for="review-comment"
                  >Comment</label
                >
                <textarea
                  class="review-form__textarea"
                  id="review-comment"
                  name="comment"
                  rows="5"
                  required
                ></textarea>
              </div>

              <div class="review-form__actions">
                <button
                  type="button"
                  class="btn btn-secondary"
                  data-review-clear
                >
                  Clear
                </button>
                <button type="submit" class="btn btn-primary">
                  Send review
                </button>
              </div>

              <p class="small-note" data-review-status aria-live="polite"></p>
            </form>
          </div>
        </section>
      </section>
    </main>

    <!-- FOOTER -->
    <!--#include file="../includes/footer-pages.html" -->

    <footer class="footer">
      <div class="container footer-bottom">
        Insurance and clinical governance • Queensland service coverage
      </div>
    </footer>
  </body>
</html>