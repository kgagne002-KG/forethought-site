<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact &amp; Referrals | Forethought Care &amp; Support</title>
    <link rel="stylesheet" href="../css/styles.css" />
    <script src="../js/main.js" defer></script>
  </head>

  <body data-business-email="forethoughtcareandsupport@gmail.com">
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- HEADER -->
    <!--#include file="../includes/header-pages.html" -->

    <header class="site-header">
      <div class="site-header__inner">
        <div class="container header-inner">
          <a class="brand" href="../index.html">
            <img
              class="brand-mark"
              src="../assets/prometheus-mark.png"
              alt="Forethought Care &amp; Support logo"
            />
          </a>

          <button
            class="menu-toggle"
            type="button"
            aria-expanded="false"
            data-menu-toggle
          >
            Menu
          </button>
        </div>

        <div class="container nav-row">
          <nav class="site-nav" aria-label="Primary navigation" data-site-nav>
            <a href="../index.html">Home</a>
            <a href="../services.html">Services</a>
            <a href="../team.html">Team</a>
            <a href="about.html">About</a>
            <a href="testimonials.html">Testimonials</a>

            <a href="contact.html">Contact</a>
            <a href="eLearning.html">eLearning</a>
            <a href="crm-portal.html">CRM Portal</a>
          </nav>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <h1>Contact &amp; Referrals</h1>
            <p class="hero-subhead">
              Get in touch to explore whether Forethought is the right fit for
              your support, service, or project.
            </p>
            <p>
              We welcome enquiries from individuals, participants, families,
              professionals, and organisations. The information below outlines
              the best way to contact us depending on your needs.
            </p>
            <div class="badge-line">
              <span class="badge">Consent first</span>
              <span class="badge">Minimal data capture</span>
              <span class="badge">Clear next steps</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container content-stack">
          <h2>Enquiries</h2>
          <p>
            Forethought provides non‑residential individual support for people
            seeking recovery‑oriented, strengths‑based assistance grounded in
            consent, choice, and collaboration.
          </p>
          <p>
            You may wish to contact us if you are an individual, family member,
            carer, or professional enquiring about:
          </p>

          <ul>
            <li>Individual Support & Recovery Coaching</li>
            <li>Capacity‑building and goal‑focused support</li>
            <li>Ethical, trauma‑aware, non‑residential supports</li>
          </ul>
          <p class="small-note">
            We will always confirm service suitability and alignment with your
            plan goals before proceeding.
          </p>
        </div>
      </section>

      <section class="section section--alt">
        <div class="container">
          <h2>Other enquiries</h2>
          <p>
            We also provide services beyond individual support, including
            business support, workplace training, and research ethics and
            governance assistance.
          </p>
          <p>These services may be suitable for:</p>
          <ul>
            <li>Small businesses and sole traders</li>
            <li>Community and not‑for‑profit organisations</li>
            <li>Workplaces seeking training or assessment</li>
            <li>Researchers and research teams</li>
          </ul>
        </div>
      </section>
      <section class="section">
        <div class="container">
          <h2>How to contact us</h2>
          <p>
            You can use the enquiry form below to contact us about any of our
            services. We’ll respond with next steps or clarification where
            helpful.
          </p>
          <p>
            If you’re unsure which service is the best fit, that’s completely
            okay — a brief description of what you’re looking for is enough.
          </p>
        </div>
      </section>
      <section class="section section--sand">
        <div class="container">
          <h2>Privacy and consent</h2>
          <p>
            Information you provide is used only to respond to your enquiry and
            for service planning where appropriate.
          </p>
          <p>
            We work in line with ethical, consent‑led practice and respect your
            privacy at every stage.
          </p>
        </div>
      </section>
      <section class="section section--alt">
        <div class="container grid-2">
          <div>
            <h2>Choose a form</h2>

            <div class="tabs" role="tablist">
              <button
                class="tab-btn"
                aria-selected="true"
                data-tab="participant"
              >
                Participant
              </button>
              <button
                class="tab-btn"
                aria-selected="false"
                data-tab="coordinator"
              >
                Support Coordinator
              </button>
              <button class="tab-btn" aria-selected="false" data-tab="family">
                Family &amp; Carer
              </button>
            </div>

            <!-- PARTICIPANT -->
            <div class="tab-panel is-active" data-panel="participant">
              <form
                class="form"
                name="contact-participant"
                method="POST"
                data-netlify="true"
                netlify-honeypot="bot-field"
                action="success.html"
                data-form
                data-form-type="contact"
                data-form-label="Participant enquiry"
              >
                <input
                  type="hidden"
                  name="form-name"
                  value="contact-participant"
                />
                <input
                  type="hidden"
                  name="submission_timestamp"
                  value=""
                  data-submission-timestamp
                />
                <p class="visually-hidden">
                  <label>
                    Don’t fill this out if you’re human:
                    <input name="bot-field" />
                  </label>
                </p>

                <div class="field">
                  <label for="pName">Full name</label>
                  <input id="pName" name="full_name" type="text" required />
                </div>

                <div class="field">
                  <label for="pEmail">Email</label>
                  <input id="pEmail" name="email" type="email" required />
                </div>

                <div class="field">
                  <label for="pPhone">Phone</label>
                  <input id="pPhone" name="phone" type="tel" required />
                </div>

                <div class="field">
                  <label for="pService">Service interest</label>
                  <select id="pService" name="service_interest">
                    <option value="recovery">Recovery Coaching</option>
                    <option value="bsp">Behaviour Support Practitioner</option>
                    <option value="case">
                      Case Management &amp; System Navigation
                    </option>
                    <option value="plan">
                      Goal Navigation &amp; Plan Review
                    </option>
                    <option value="training">Training</option>
                  </select>
                </div>

                <div class="field">
                  <label for="pGoal">Primary goal / reason for contact</label>
                  <textarea id="pGoal" name="primary_goal"></textarea>
                </div>

                <div class="field">
                  <label>
                    <input type="checkbox" name="consent" required />
                    I consent to being contacted and to the information provided
                    being stored for intake and service planning.
                  </label>
                </div>

                <div class="form-actions">
                  <button class="btn btn-primary" type="submit">
                    Send enquiry
                  </button>
                  <a class="btn btn-secondary" href="crm-portal.html"
                    >Use secure portal</a
                  >
                </div>
              </form>
            </div>

            <!-- SUPPORT COORDINATOR -->
            <div class="tab-panel" data-panel="coordinator">
              <form
                class="form"
                name="contact-coordinator"
                method="POST"
                data-netlify="true"
                netlify-honeypot="bot-field"
                action="success.html"
                data-form
                data-form-type="referral"
                data-form-label="Support coordinator referral"
              >
                <input
                  type="hidden"
                  name="form-name"
                  value="contact-coordinator"
                />
                <input
                  type="hidden"
                  name="submission_timestamp"
                  value=""
                  data-submission-timestamp
                />
                <p class="visually-hidden">
                  <label>
                    Don’t fill this out if you’re human:
                    <input name="bot-field" />
                  </label>
                </p>

                <div class="field">
                  <label for="scName">Referrer name</label>
                  <input
                    id="scName"
                    name="referrer_name"
                    type="text"
                    required
                  />
                </div>

                <div class="field">
                  <label for="scOrg">Organisation</label>
                  <input id="scOrg" name="organisation" type="text" />
                </div>

                <div class="field">
                  <label for="scEmail">Email</label>
                  <input id="scEmail" name="email" type="email" required />
                </div>

                <div class="field">
                  <label for="scParticipant">Participant name (optional)</label>
                  <input
                    id="scParticipant"
                    name="participant_name"
                    type="text"
                  />
                </div>

                <div class="field">
                  <label for="scServices">Services requested</label>
                  <select id="scServices" name="services_requested">
                    <option>Recovery Coaching</option>
                    <option>Behaviour Support Practitioner</option>
                    <option>Case Management &amp; System Navigation</option>
                    <option>Training</option>
                  </select>
                </div>

                <div class="field">
                  <label for="scSummary"
                    >Brief summary / desired outcomes</label
                  >
                  <textarea id="scSummary" name="summary"></textarea>
                </div>

                <div class="field">
                  <label>
                    <input type="checkbox" name="consent" required />
                    I confirm participant consent has been obtained.
                  </label>
                </div>

                <div class="form-actions">
                  <a class="btn btn-secondary" href="crm-portal.html"
                    >Secure upload link</a
                  >
                </div>
              </form>
            </div>

            <!-- FAMILY / CARER -->
            <div class="tab-panel" data-panel="family">
              <form
                class="form"
                name="contact-family"
                method="POST"
                data-netlify="true"
                netlify-honeypot="bot-field"
                action="success.html"
                data-form
                data-form-type="family"
                data-form-label="Family or carer enquiry"
              >
                <input type="hidden" name="form-name" value="contact-family" />
                <input
                  type="hidden"
                  name="submission_timestamp"
                  value=""
                  data-submission-timestamp
                />

                <p class="visually-hidden">
                  <label>
                    Don’t fill this out if you’re human:
                    <input name="bot-field" />
                  </label>
                </p>

                <div class="field">
                  <label for="fName">Your name</label>
                  <input id="fName" name="enquirer_name" type="text" required />
                </div>

                <div class="field">
                  <label for="fEmail">Email</label>
                  <input id="fEmail" name="email" type="email" required />
                </div>

                <div class="field">
                  <label for="fInterest">Training interest</label>
                  <select id="fInterest" name="training_interest">
                    <option value="public">Public short module</option>
                    <option value="private">Private workshop</option>
                  </select>
                </div>

                <div class="field">
                  <label for="fMessage">What do you need help with?</label>
                  <textarea id="fMessage" name="message"></textarea>
                </div>

                <div class="field">
                  <label>
                    <input type="checkbox" name="consent" required />
                    I consent to being contacted and to information provided
                    being stored for this enquiry.
                  </label>
                </div>

                <div class="form-actions">
                  <button class="btn btn-primary" type="submit">
                    Send enquiry
                  </button>
                  <a class="btn btn-secondary" href="crm-portal.html"
                    >Secure portal</a
                  >
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <!--#include file="../includes/footer-pages.html" -->

    <footer class="footer">
      <div class="container footer-bottom">
        Accessibility • Privacy &amp; consent • Contact details • Newsletter
        signup
      </div>
    </footer>
  </body>
</html>
