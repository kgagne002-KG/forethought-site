  <!--/pages paths -->
  <link rel="stylesheet" href="../css/styles.css" />
  <script src="../js/main.js" defer></script>
</head>

<body
  data-business-email="forethoughtcareandsupport@gmail.com"
  data-service-default="Business Support & Administration"
>
  <a class="skip-link" href="#main">Skip to main content</a>

<!-- HEADER -->
  <!--#include file="../includes/header-pages.html" -->

  <header class="site-header">
  <div class="site-header__inner">

    <!-- BRAND ROW -->
    <div class="container header-inner">
      <a class="brand" href="../index.html">
        <img class="brand-mark" src="../assets/prometheus-mark.png" alt="...">
      </a>

      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="primary-nav">
        Menu
      </button>
</div>

      <!-- NAV ROW -->
<div class="container nav-row">
  <nav id="primary-nav" class="site-nav" aria-label="Primary navigation" data-site-nav>
    <a href="../index.html">Home</a>
    <a href="../services.html" aria-current="page">Services</a>
    <a href="../team.html">Team</a>

    <a href="about.html">About</a>
    <a href="testimonials.html">Testimonials</a>
    
    <a class="nav-cta" href="contact.html">Contact</a>

   
  </nav>
</div>
  </header>

  <main id="main">
    <section class="page-hero">
      <div class="container">
        <h1>Business Support &amp; Administration</h1>
        
<p class="lead">
      Practical, ethical support for people and organisations doing meaningful work.
    </p>
    <p>
      Forethought provides business and administrative support for small businesses,
      sole traders, and community organisations needing clear systems, reliable
      documentation, and calm guidance through complexity.
    </p>
  </div>
</section>


    <section class="section">
  <div class="container content-stack">
    <h2>What we support</h2>
    <p>
      This service focuses on strengthening the behind‑the‑scenes work that allows
      organisations to operate confidently and sustainably.
    </p>
    <p>
      We help translate ideas, obligations, and goals into practical systems that
      are proportionate, transparent, and aligned with real‑world capacity.
    </p>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <h2>This may include</h2>
    <ul class="feature-list">
          <li>Business administration and operational support</li>
      <li>Process and workflow development</li>
      <li>Documentation, templates, and record‑keeping systems</li>
      <li>Policy and procedure drafting</li>
      <li>Ethical governance and compliance support</li>
      <li>Support for values‑led and community‑focused organisations</li>
          <li>Web Development</li>
          <li>Copy Editing &amp; Proofreading</li>
          <li>Consumer Advising</li>
          <li>Literature Review</li>
        </ul>
  </div>
</section>

       <section class="section section--sand">
  <div class="container">
    <h2>Who this service may suit</h2>
    <p>
      Business Support & Administration may be helpful if you are:
    </p>
    <ul>
      <li>Running a small business or sole trade</li>
      <li>Working in a community or not‑for‑profit setting</li>
      <li>Establishing or refining operational systems</li>
      <li>Seeking ethical, plain‑language administrative support</li>
      <li>Balancing compliance needs with human‑centred work</li>
    </ul>
  </div>
</section>

        <section class="section">
  <div class="container">
    <h2>How we work</h2>
    <p>
      Our approach is collaborative, proportionate, and grounded in respect for
      the realities of small teams and limited resources.
    </p>
    <p>
      We prioritise clarity over jargon, practical tools over theoretical models,
      and systems that people can actually maintain over complexity that creates
      additional burden.
    </p>
  </div>
</section>

    <section class="section section-alt">
  <div class="container">
    <h2>Enquire about this service</h2>
    <p class="small-note">
      Send a brief enquiry and we’ll respond with next steps.
    </p>

    <form
      class="service-form"
      name="service-business-support"
      method="POST"
      action="success.html"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-service-form
      data-service="Business Support & Administration"
    >
      <input type="hidden" name="form-name" value="service-business-support" />
      <input type="hidden" name="submission_timestamp" value="" data-submission-timestamp />

      <p class="visually-hidden">
        <label>
          Don’t fill this out if you’re human:
          <input name="bot-field" />
        </label>
      </p>

      <label>
        Full name
        <input type="text" name="name" required />
      </label>

      <label>
        Email
        <input type="email" name="email" required />
      </label>

      <label>
        Phone (optional)
        <input type="tel" name="phone" />
      </label>

      <label>
        Service interest
        <select name="service_interest" required>
          <option value="" disabled selected>Select one…</option>
          <option>Business Support & Administration</option>
          <option>Workplace Training & Assessment</option>
          <option>Research Ethics & Governance Support</option>
          <option>Other</option>
        </select>
      </label>

      <label>
        What support are you looking for?
        <textarea name="message" rows="4" required></textarea>
      </label>

      <label class="checkbox">
        <input type="checkbox" name="consent" required />
        I consent to being contacted and to the information provided being stored
        for enquiry and service planning.
      </label>

      <input type="hidden" name="source_page" value="" data-source-page />

      <button class="btn btn-primary" type="submit">
        Send enquiry
      </button>

      <p class="form-help">
        Prefer the full referrals page?
        <a href="contact.html">Go to Contact & Referrals</a>.
      </p>
    </form>
      </div>
    </section>
  </main>

